# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Traffic Provider Configuration (Mode A: Live Traffic)
# Options: "TomTom Traffic Flow API", "HERE Traffic API", "Caltrans PeMS QuickMap"
TRAFFIC_PROVIDER_NAME="TomTom Traffic Flow API"

# API Key for live traffic stream (Leave empty to operate in Mode B: Historical Replay / Demo)
TRAFFIC_API_KEY="YOUR_TRAFFIC_API_KEY_HERE"

# Configurable data refresh interval in seconds (default: 300 = 5 minutes)
TRAFFIC_REFRESH_INTERVAL="300"
